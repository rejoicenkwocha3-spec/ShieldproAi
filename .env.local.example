# Shield Pro AI Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase - Required for authentication and database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Provider - For AI security intelligence assistant (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Selar Webhook Secret - For payment verification (request from Selar)
SELAR_WEBHOOK_SECRET=your_selar_webhook_secret
